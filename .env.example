# ══════════════════════════════════════════════════════════
#  Configuração rápida — o essencial para subir o bot
# ══════════════════════════════════════════════════════════

# Token do bot (crie um bot no Stoat/Revolt e cole o token aqui)
BOT_TOKEN=

# ID do perfil do DONO do bot (clique no seu perfil → copiar ID).
# É quem ganha os comandos administrativos (&game admin etc.).
DONO=

# ID do SERVIDOR onde a IA vai funcionar. "*" libera em todos.
# Vazio = a IA não roda em lugar nenhum (o resto do bot funciona normal).
SERVIDOR=

# ── IA ──
# IA=0 desliga todos os módulos de IA (chat, modia, comentários, voz-IA).
IA=1

# Como a IA pensa: "local" roda um modelo na sua máquina (sem custo, sem
# token, precisa de ~4 GB de RAM livre); "online" usa uma plataforma via
# token. Deixe vazio para apontar LLM_URL manualmente (avançado, abaixo).
IA_MODO=local

# Modelo. No modo local é um GGUF do Hugging Face (repo:quantização), baixado
# automaticamente no primeiro arranque e guardado no volume (/data/modelos).
# No modo online é o nome do modelo na plataforma (ex.: openai/gpt-4o-mini).
#MODELO=bartowski/Qwen2.5-3B-Instruct-GGUF:Q4_K_M

# Token da plataforma (só no modo online). O padrão de LLM_URL é o
# OpenRouter (https://openrouter.ai) — um token dá acesso a vários modelos.
#TOKEN_IA=

# Personalidade padrão da IA, no seu texto. Pode trocar depois, por servidor,
# com o comando &personalidade — que tem prioridade sobre esta.
#PROMPT=Você é um assistente simpático e direto do servidor.

# Geração de imagem: já vem embutida (stable-diffusion.cpp + SD-Turbo). O
# modelo (~2,3 GB) baixa no PRIMEIRO pedido de desenho e fica no volume.
# IMAGEM=0 desliga; SD_URL aponta para um A1111/Forge externo, se preferir.
IMAGEM=1

# ══════════════════════════════════════════════════════════
#  Avançado — só mexa se souber o que quer
#  (estes nomes têm prioridade sobre os amigáveis acima)
# ══════════════════════════════════════════════════════════

# ══════════════════════════════════════════════════════════
#  .env — para rodar o bot LOCALMENTE (fora do container)
#
#  ⚠️ Em produção o bot roda no Portainer, e as variáveis vêm do bloco
#  `environment` da stack — este arquivo NÃO é usado lá. Ele serve para
#  desenvolvimento e teste na sua máquina.
#
#  Copie para `.env` no mesmo diretório do main.js:
#      cp .env.example .env
#
#  O main.js carrega este arquivo no boot (`import 'dotenv/config'`),
#  e o dotenv lê o `.env` do DIRETÓRIO ONDE O NODE FOI EXECUTADO —
#  não do diretório do arquivo. Rodando de outro lugar, use:
#      cd ~/Downloads/github && node main.js
#
#  NUNCA comite o `.env` real: ele está no .gitignore de propósito.
# ══════════════════════════════════════════════════════════

# ── Obrigatório ───────────────────────────────────────────

# ── Onde os dados ficam ───────────────────────────────────
# Rodando direto, o padrão é o diretório atual. Aponte para um lugar
# estável, senão o banco muda de lugar conforme de onde você executa.
CONFIG_PATH=./dados/automod-config.json
DB_PATH=./dados/stoat.db

TZ=America/Sao_Paulo

# ── Serviço de ferramentas da IA ──────────────────────────
# Serviço de IA: sobe embutido no container (localhost:8090). Só defina
# IA_SERVICO_URL se rodá-lo em outra máquina. IA_EMBUTIDA=0 desliga o embutido.
#IA_SERVICO_URL=
# Inferência (llama.cpp / llama-swap / Ollama, formato OpenAI):
#LLM_URL=http://host.docker.internal:8081
LLM_MODEL=
# Voz nas calls (opcional): VOZ_ATIVA=1 e pronto — o Piper vem na imagem e
# as vozes são baixadas sozinhas no primeiro arranque (para o volume).
VOZ_ATIVA=0
# Quais vozes baixar (nomes do catálogo https://huggingface.co/rhasspy/piper-voices,
# separados por vírgula; a primeira vira a padrão). Ex.: pt_BR-faber-medium,pt_BR-dii-medium
#VOZES=pt_BR-faber-medium
# Senha do serviço de voz embutido (recomendado definir qualquer valor)
#VOZ_CHAVE=
# Super-admins do bot (IDs separados por vírgula). Vazio = ninguém.
#SUPER_ADMINS=

# ── Modelos por papel (avançado) ──────────────────────────
# Vazio = tudo usa o MODELO/LLM_MODEL principal. Defina só se o seu servidor
# de LLM tiver modelos distintos por função (llama-swap, por exemplo):
#LLM_MODEL_LEVE=
#LLM_MODEL_CODIGO=
#LLM_MODEL_LOGICA=

# Quanto cada um fica residente (o leve responde quase tudo; os pesados
# saem rápido para devolver a GPU a quem está usando o computador).
# CHAT_KEEP_LEVE=30m
# CHAT_KEEP_PESADO=60s

# ── Agente de memória ─────────────────────────────────────
MEMORIA_AGENTE=on
MEMORIA_DEBOUNCE_MS=8000
MEMORIA_MIN_CHARS=12

# ── Busca web (SearXNG) ───────────────────────────────────
# Sem esta linha a busca fica DESLIGADA e o bot nem gasta inferência
# decidindo se deveria buscar.
# Busca na web da IA: o SearXNG já sobe junto no docker-compose — nada a
# configurar. Só defina SEARXNG_URL se usar uma instância própria (ou defina
# vazio para desligar a busca).
#SEARXNG_URL=http://searxng:8080

# ── Log ───────────────────────────────────────────────────
CHAT_DEBUG=1
