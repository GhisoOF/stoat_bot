node_modules/
# Segredos e config de máquina — NUNCA versionados.
# O padrão `.env` do Git só cobre a raiz; os subdiretórios precisam ser
# listados. Sem isso o token do ia-servico entraria no repositório.
.env
.env.*
!.env.example
ia-servico/.env
voz-servico/.env
**/.env
automod-config.json
npm-debug.log*

# Zips de deploy e logs de depuração — nunca versionados.
# (Esta linha vive AQUI porque o deploy sobrescreve o .gitignore local:
#  qualquer adição feita só na máquina se perde no próximo unzip.)
*.zip
_stoat-bot*_logs.txt
*.log
blocklist-cache.bin

# Banco e dados locais (31 out 2026, R10): rodando fora do Docker o banco fica
# em ./dados (DB_PATH) — conversas, punições, IDs. Nunca no Git nem na imagem.
*.db
*.db-wal
*.db-shm
/dados/

# Arquivos que o bot grava AO LADO DO BANCO (3 nov 2026, P5): rodando fora do Docker sem DB_PATH,
# o banco é ./stoat.db e eles caem na raiz (o log-segredo.key de um teste caiu aqui). Ancorados com
# `/`: só os da raiz — o modulos/moderacao/dados/classificador-texto.json (o modelo dentro do
# código) NÃO é ignorado.
/log-segredo.key
/bateria-imagens.jsonl
/bateria-treino.jsonl
/bateria-aviso.chave
/classificador-texto.json
