# ══════════════════════════════════════════════════════════
#  .env do judy-ia — vai NESTE diretório (ao lado do servidor.js)
#
#  O dotenv lê o .env de onde o node foi executado. O serviço OpenRC
#  define `directory=` para cá, então rodando por ele funciona sempre.
#  À mão:  cd ia-servico && node servidor.js
#
#  Este arquivo NÃO é versionado (.gitignore) — e por isso ele some
#  quando a pasta `ia-servico` é apagada e recriada num deploy.
#  Guarde uma cópia fora:  cp ia-servico/.env ~/judy-github.env
# ══════════════════════════════════════════════════════════

# Token do GitHub. OBRIGATÓRIO para repositório privado: sem ele a API
# responde 404 (não 401), o que parece "não existe" e engana.
GITHUB_TOKEN=github_pat_cole_aqui
GITHUB_REPO=GhisoOF/stoat_bot
GITHUB_BRANCH=main

# Ollama: se o OLLAMA_HOST aponta para um IP específico, ele deixa de
# escutar em 127.0.0.1 — use aqui o mesmo endereço.
OLLAMA_URL=http://100.74.70.106:11434
OLLAMA_MODEL=qwen3.5:9b

# Porta do serviço (o bot aponta para cá via IA_SERVICO_URL)
PORTA=8090

# DNS de emergência: se o /etc/resolv.conf ficar sem `nameserver`, o
# serviço resolve por conta própria em vez de ficar mudo.
DNS_FALLBACK=100.100.100.100,1.1.1.1,8.8.8.8

# Busca web (opcional)
# SEARXNG_URL=http://localhost:8080
