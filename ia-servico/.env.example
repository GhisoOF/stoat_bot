# ══════════════════════════════════════════════════════════
#  .env do ia-servico — só para rodá-lo FORA do container da Judy.
#  No container, o iniciar.js sobe o serviço sozinho com o .env da raiz.
#
#  (2 nov 2026, P4) O serviço é só da moderação: a visão das imagens
#  (/moderar-imagem) e o hash das fotos de perfil (/hash-imagem). O chat
#  IA saiu, e com ele o GitHub, a busca na web e a geração de imagem.
#  À mão:  cd ia-servico && node servidor.js
# ══════════════════════════════════════════════════════════

# Chave obrigatória (a mesma do .env do bot): sem ela o serviço não sobe
IA_SERVICO_CHAVE=troque_por_uma_chave_longa

# Backend LLM (formato OpenAI): llama-swap/llama.cpp
LLM_URL=http://llama:8080

# O modelo multimodal que descreve as imagens (sem ele, só o hash funciona)
#LLM_MODEL_VISAO=visao

# Porta do serviço (o bot aponta para cá via IA_SERVICO_URL)
PORTA=8090

# DNS de emergência: se o /etc/resolv.conf ficar sem `nameserver`, o
# serviço resolve por conta própria em vez de ficar mudo.
DNS_FALLBACK=100.100.100.100,1.1.1.1,8.8.8.8
