# Copie para .env (na mesma pasta) e preencha. O .env NÃO vai para o Git.
#
#   cp .env.example .env && nano .env
#
# Token do GitHub — OBRIGATÓRIO para ler o código de um repositório privado.
# Crie em: github.com/settings/tokens (fine-grained), com acesso ao repo e
# permissão "Contents: Read-only". Prefira sem data de expiração.
GITHUB_TOKEN=

# Opcional: chave para proteger a porta 8090 (use a MESMA no bot, em IA_SERVICO_CHAVE)
# IA_CHAVE=
