#!/sbin/openrc-run
# ══════════════════════════════════════════════════════════
#  Serviço OpenRC para o judy-ia (ferramentas da IA).
#
#  Instalar:
#    sudo cp scripts/openrc/judy-ia /etc/init.d/judy-ia
#    sudo chmod +x /etc/init.d/judy-ia
#    sudo cp scripts/openrc/judy-ia.confd /etc/conf.d/judy-ia
#    sudo nano /etc/conf.d/judy-ia         # ajuste usuário e diretório
#    sudo rc-update add judy-ia default
#    sudo rc-service judy-ia start
#
#  Log:      tail -f /var/log/judy-ia.log
#  Saúde:    curl localhost:8090/saude
#  Diagnóstico completo:  curl localhost:8090/diagnostico
# ══════════════════════════════════════════════════════════

: ${IA_USER:=ghiso}
: ${IA_DIR:=/home/ghiso/Downloads/github/ia-servico}
: ${IA_NODE:=/usr/bin/node}

name="judy-ia"
description="Serviço de ferramentas da IA (GitHub, busca, cálculo)"

command="${IA_NODE}"
command_args="servidor.js"
command_user="${IA_USER}"
command_background="yes"
directory="${IA_DIR}"          # o dotenv lê o .env DESTE diretório
pidfile="/run/judy-ia.pid"
output_log="/var/log/judy-ia.log"
error_log="/var/log/judy-ia.log"

depend() {
    need net
    after ollama
}

start_pre() {
    if [ ! -f "${IA_DIR}/servidor.js" ]; then
        eerror "Não achei ${IA_DIR}/servidor.js — ajuste IA_DIR em /etc/conf.d/judy-ia"
        return 1
    fi
    # O .env guarda o GITHUB_TOKEN. Sem ele o serviço sobe, mas a leitura do
    # repositório responde 404 — erro que parece "não existe" e custa horas
    # de investigação. Melhor avisar aqui, no start.
    if [ ! -f "${IA_DIR}/.env" ]; then
        ewarn "Sem ${IA_DIR}/.env — a leitura do repositório privado vai falhar com 404."
        ewarn "Crie com: echo 'GITHUB_TOKEN=github_pat_...' > ${IA_DIR}/.env"
    fi
    checkpath --file --owner "${IA_USER}" --mode 0644 /var/log/judy-ia.log
}
