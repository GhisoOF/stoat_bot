# ══════════════════════════════════════════════════════════
#  .env do judy-voz — vai NESTE diretório (ao lado do servidor.js)
#
#  Este arquivo NÃO é versionado (.gitignore) e SOME quando a pasta
#  é recriada num deploy. Guarde uma cópia fora:
#     cp voz-servico/.env ~/judy-voz.env
# ══════════════════════════════════════════════════════════

# Token do bot (o MESMO do bot principal — é ele que entra na call)
BOT_TOKEN=cole_o_token_aqui

# Chave que o bot apresenta no header x-chave. SEM ISTO qualquer coisa
# na Tailscale pode fazer o bot falar na sua call. Gere com:
#   openssl rand -hex 24
VOZ_CHAVE=gere_uma_chave_aqui

VOZ_PORTA=8091

# 1 = log detalhado. Com isto ligado o LiveKit também passa a falar, e é a
# única janela para o que acontece durante uma entrada que trava. Deixe em 0
# no dia a dia: ele fala MUITO.
VOZ_DEBUG=0

# Endereço da API do Stoat. Só mexa se a instância não for a oficial —
# apontar para o lugar errado faz o join_call receber a página de erro de um
# proxy em vez da resposta da API, e o sintoma vira "trava ao entrar".
#STOAT_API=https://api.stoat.chat

# Node LiveKit a usar ao INICIAR uma call (quando ninguém entrou ainda).
# Vazio = o primeiro que a API anunciar em `GET /` → features.livekit.nodes.
# Só mexa se quiser fixar uma região específica.
#VOZ_NODE_LIVEKIT=
# URL pública do LiveKit, só como reserva para o /entrar-com-token (&tts resgatar)
# quando o GET / da API não anunciar o node do evento UserMoveVoiceChannel.
#VOZ_LIVEKIT_URL=

# Tetos de tempo da entrada na call. O primeiro cobre o pedido inteiro
# (inclusive o join do revoice); o segundo, só a confirmação da sala.
#VOZ_ENTRAR_TIMEOUT_MS=20000
#VOZ_JOIN_TIMEOUT_MS=25000

# ── Piper (TTS offline) ──
# Preenchidos pelo scripts/instalar-piper.sh
PIPER_BIN=/home/ghiso/.local/share/piper/piper
PIPER_VOZES=/home/ghiso/.local/share/piper/vozes
PIPER_VOZ=pt_BR-faber-medium

# Limites
TTS_MAX_CHARS=400          # texto maior que isso é cortado
TTS_TIMEOUT_MS=30000
VOZ_MAX_FILA=5             # falas esperando por canal
VOZ_FALA_MAX_MS=45000      # teto de duração de uma fala
VOZ_JOIN_TIMEOUT_MS=25000
